# Putcafe site — imported by /root/orion/Caddyfile (the shared edge Caddy) via
# `import /root/*/site.caddy` (or a putcafe-specific line added by setup.sh).
# ORION_HOST comes from /root/orion/orion-web.env via the edge container's env_file,
# so the host tracks the edge automatically: putcafe.203-0-113-10.sslip.io.
#
#   /web/[<slot>/]    -> web builds (rsynced by ci.yml / deploy.sh)
#   /api/positions/*  -> positions-backend container (127.0.0.1:8101)
#   /api/bot/*        -> bot-backend container       (127.0.0.1:8102)
#   /                 -> redirect to /web/
#
# ops.<host> is the VPS-wide ops UI (Dozzle, all containers on the box, port 8103);
# auth is handled by Dozzle itself (users.yml on the VPS), so this file stays
# secret-free.

putcafe.{$ORION_HOST} {
	root * /root/putcafe/site
	reverse_proxy /api/positions/* 127.0.0.1:8101
	reverse_proxy /api/bot/* 127.0.0.1:8102
	file_server
	redir / /web/ 302
}

ops.{$ORION_HOST} {
	reverse_proxy 127.0.0.1:8103
}
