# Copy to frontend/.env (gitignored) and adjust. All keys are optional.

# Base URL of the deployed API (positions + bot behind one reverse proxy), e.g.
# https://putcafe.<your-host>. Leave empty to call the same origin the app is
# served from — which is what the local-stack and local-bot modes below rely on.
VITE_API_BASE=

# Set to 1 to run against the full local stack from scripts/dev/local/run-stack.sh:
# Vite proxies /api/positions/* and /api/bot/* to the local containers.
VITE_LOCAL_STACK=

# Set to 1 to test bot changes pre-merge: /api/bot/* goes to a locally run bot
# (uvicorn :8102) while /api/positions/* still hits VITE_API_BASE.
VITE_LOCAL_BOT=
